generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth & Workspace ───
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  avatarUrl     String?
  locale        String    @default("en-IN")
  timezone      String    @default("Asia/Kolkata")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Better Auth Fields
  emailVerified Boolean   @default(false)
  image         String?

  workspaces    WorkspaceMember[]
  activities    Activity[]
  tasks         Task[]
  notes         Note[]
  views         View[]
  attachments   Attachment[]
  auditLogs     AuditLog[]
  notifications Notification[]
  sessions      Session[]
  accounts      Account[]
  joinRequests  JoinRequest[]
  chatSessions  ChatSession[]
}

model Workspace {
  id                  String    @id @default(cuid())
  name                String
  logo                String?
  domain              String?   @unique
  createdAt           DateTime  @default(now())

  members             WorkspaceMember[]
  people              Person[]
  companies           Company[]
  opportunities       Opportunity[]
  pipelines           Pipeline[]
  pipelineStages      PipelineStage[]
  tasks               Task[]
  notes               Note[]
  views               View[]
  workflows           Workflow[]
  dashboards          Dashboard[]
  tags                Tag[]
  customFields        CustomFieldDefinition[]
  attachments         Attachment[]
  customFieldValues   CustomFieldValue[]
  tagAssignments      TagAssignment[]
  opportunityContacts OpportunityContact[]
  auditLogs           AuditLog[]
  notifications       Notification[]
  activities          Activity[]
  domainAutoJoin      Boolean          @default(false)
  domainRequestJoin   Boolean          @default(true)
  invitations         Invitation[]
  joinRequests        JoinRequest[]
  smtpConfig          SmtpConfig?
  chatSessions        ChatSession[]
}

model SmtpConfig {
  id          String    @id @default(cuid())
  host        String
  port        Int
  username    String
  password    String
  senderName  String
  senderEmail String
  workspaceId String    @unique
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model WorkspaceMember {
  id          String     @id @default(cuid())
  role        MemberRole @default(MEMBER)
  userId      String
  workspaceId String
  joinedAt    DateTime   @default(now())

  user        User       @relation(fields: [userId], references: [id])
  workspace   Workspace  @relation(fields: [workspaceId], references: [id])

  @@unique([userId, workspaceId])
}

enum MemberRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  RESTORE
}

enum NotificationType {
  TASK_ASSIGNED
  MEMBER_INVITED
  WORKFLOW_COMPLETED
  ALERT
}

model AuditLog {
  id          String       @id @default(cuid())
  entityType  String
  entityId    String
  action      AuditAction
  before      Json?
  after       Json?
  occurredAt  DateTime     @default(now())
  workspaceId String
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([userId])
}

model Notification {
  id          String            @id @default(cuid())
  type        NotificationType
  title       String
  message     String
  isRead      Boolean           @default(false)
  link        String?
  createdAt   DateTime          @default(now())
  workspaceId String
  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([userId])
}

model ChatSession {
  id          String        @id @default(cuid())
  title       String        @default("New Chat")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  workspaceId String
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages    ChatMessage[]

  @@index([workspaceId, userId])
}

model ChatMessage {
  id          String      @id @default(cuid())
  role        String
  content     String
  createdAt   DateTime    @default(now())
  sessionId   String
  session     ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

// ─── CRM Core Entities ───
// NOTE: PostgreSQL GIN/tsvector weighted search indexes on name and email fields cannot be declared natively in Prisma schema and must be added via a raw SQL migration file (e.g. migration.sql).
model Person {
  id                String             @id @default(cuid())
  firstName         String
  lastName          String
  email             String?
  phone             String?
  jobTitle          String?
  city              String?
  avatarUrl         String?
  linkedInUrl       String?
  leadSource        String?
  industry          String?
  tagsString        String?
  version           Int                @default(1)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  deletedAt         DateTime?

  workspaceId       String
  workspace         Workspace          @relation(fields: [workspaceId], references: [id])
  companyId         String?
  company           Company?           @relation(fields: [companyId], references: [id])

  activities        Activity[]
  tasks             Task[]
  notes             Note[]
  opportunities     OpportunityContact[]
  attachments       Attachment[]
  customFieldValues CustomFieldValue[]
  tags              TagAssignment[]

  @@index([workspaceId])
  @@index([deletedAt])
  @@index([companyId])
}

model Company {
  id                String             @id @default(cuid())
  name              String
  domain            String?
  address           String?
  city              String?
  industry          String?
  employeeCount     Int?
  annualRevenue     Decimal?           @db.Decimal(15, 2)
  linkedInUrl       String?
  logoUrl           String?
  version           Int                @default(1)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  deletedAt         DateTime?

  workspaceId       String
  workspace         Workspace          @relation(fields: [workspaceId], references: [id])

  people            Person[]
  opportunities     Opportunity[]
  activities        Activity[]
  tasks             Task[]
  notes             Note[]
  attachments       Attachment[]
  customFieldValues CustomFieldValue[]
  tags              TagAssignment[]

  @@index([workspaceId])
  @@index([deletedAt])
}

model Opportunity {
  id                String             @id @default(cuid())
  name              String
  amount            Decimal?           @db.Decimal(12, 2)
  closeDate         DateTime?
  probability       Int?
  stageId           String
  stage             PipelineStage      @relation(fields: [stageId], references: [id])
  source            String?
  version           Int                @default(1)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  deletedAt         DateTime?

  workspaceId       String
  workspace         Workspace          @relation(fields: [workspaceId], references: [id])
  companyId         String?
  company           Company?           @relation(fields: [companyId], references: [id])

  contacts          OpportunityContact[]
  activities        Activity[]
  tasks             Task[]
  notes             Note[]
  attachments       Attachment[]
  customFieldValues CustomFieldValue[]
  tags              TagAssignment[]

  @@index([workspaceId])
  @@index([deletedAt])
  @@index([stageId])
  @@index([companyId])
}

model OpportunityContact {
  id            String      @id @default(cuid())
  role          String?
  workspaceId   String
  workspace     Workspace   @relation(fields: [workspaceId], references: [id])
  opportunityId String
  personId      String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id])
  person        Person      @relation(fields: [personId], references: [id])

  @@unique([opportunityId, personId])
}

model Pipeline {
  id          String          @id @default(cuid())
  name        String
  stages      PipelineStage[]
  isDefault   Boolean         @default(false)

  workspaceId String
  workspace   Workspace       @relation(fields: [workspaceId], references: [id])
}

model PipelineStage {
  id            String        @id @default(cuid())
  name          String
  color         String        @default("#6366f1")
  position      Int           @default(0)
  probability   Int           @default(100)
  version       Int           @default(1)

  workspaceId   String
  workspace     Workspace     @relation(fields: [workspaceId], references: [id])
  pipelineId    String
  pipeline      Pipeline      @relation(fields: [pipelineId], references: [id])
  opportunities Opportunity[]
}

// ─── Activities ───
model Task {
  id            String       @id @default(cuid())
  title         String
  description   String?
  status        TaskStatus   @default(TODO)
  priority      Priority     @default(MEDIUM)
  dueDate       DateTime?
  completedAt   DateTime?
  version       Int          @default(1)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  deletedAt     DateTime?

  workspaceId   String
  workspace     Workspace    @relation(fields: [workspaceId], references: [id])
  assigneeId    String?
  assignee      User?        @relation(fields: [assigneeId], references: [id])
  personId      String?
  person        Person?      @relation(fields: [personId], references: [id])
  companyId     String?
  company       Company?     @relation(fields: [companyId], references: [id])
  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id])

  @@index([workspaceId])
  @@index([deletedAt])
  @@index([personId])
  @@index([companyId])
  @@index([opportunityId])
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Note {
  id            String       @id @default(cuid())
  title         String?
  body          Json
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  deletedAt     DateTime?

  workspaceId   String
  workspace     Workspace    @relation(fields: [workspaceId], references: [id])
  authorId      String?
  author        User?        @relation(fields: [authorId], references: [id])
  personId      String?
  person        Person?      @relation(fields: [personId], references: [id])
  companyId     String?
  company       Company?     @relation(fields: [companyId], references: [id])
  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id])

  @@index([workspaceId])
  @@index([deletedAt])
  @@index([personId])
  @@index([companyId])
  @@index([opportunityId])
}

model Activity {
  id            String       @id @default(cuid())
  type          ActivityType
  title         String
  body          String?
  metadata      Json?
  occurredAt    DateTime     @default(now())

  workspaceId   String
  workspace     Workspace    @relation(fields: [workspaceId], references: [id])
  authorId      String?
  author        User?        @relation(fields: [authorId], references: [id])
  personId      String?
  person        Person?      @relation(fields: [personId], references: [id])
  companyId     String?
  company       Company?     @relation(fields: [companyId], references: [id])
  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id])

  @@index([workspaceId])
  @@index([occurredAt])
  @@index([personId])
  @@index([companyId])
  @@index([opportunityId])
}

enum ActivityType {
  NOTE
  EMAIL
  CALL
  MEETING
  TASK_COMPLETED
  DEAL_STAGE_CHANGED
  RECORD_CREATED
  RECORD_UPDATED
}

// ─── Attachments ───
model Attachment {
  id            String       @id @default(cuid())
  name          String
  mimeType      String
  sizeBytes     Int
  url           String
  createdAt     DateTime     @default(now())

  workspaceId   String
  workspace     Workspace    @relation(fields: [workspaceId], references: [id])
  uploadedById  String?
  uploadedBy    User?        @relation(fields: [uploadedById], references: [id])
  checksum      String?
  storageKey    String
  isPublic      Boolean      @default(false)

  personId      String?
  person        Person?      @relation(fields: [personId], references: [id])
  companyId     String?
  company       Company?     @relation(fields: [companyId], references: [id])
  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id])

  @@index([workspaceId])
  @@index([personId])
  @@index([companyId])
  @@index([opportunityId])
}

// ─── Custom Fields ───
model CustomFieldDefinition {
  id          String             @id @default(cuid())
  name        String
  label       String
  type        FieldType
  entityType  EntityType
  options     Json?
  isRequired  Boolean            @default(false)
  position    Int                @default(0)

  workspaceId String
  workspace   Workspace          @relation(fields: [workspaceId], references: [id])
  values      CustomFieldValue[]

  @@unique([workspaceId, entityType, name])
}

model CustomFieldValue {
  id            String                 @id @default(cuid())
  value         Json

  workspaceId   String
  workspace     Workspace              @relation(fields: [workspaceId], references: [id])
  fieldId       String
  field         CustomFieldDefinition  @relation(fields: [fieldId], references: [id])
  personId      String?
  person        Person?                @relation(fields: [personId], references: [id])
  companyId     String?
  company       Company?               @relation(fields: [companyId], references: [id])
  opportunityId String?
  opportunity   Opportunity?           @relation(fields: [opportunityId], references: [id])

  @@unique([fieldId, personId])
  @@unique([fieldId, companyId])
  @@unique([fieldId, opportunityId])
}

enum FieldType {
  TEXT
  NUMBER
  CURRENCY
  DATE
  BOOLEAN
  EMAIL
  PHONE
  URL
  SELECT
  MULTI_SELECT
  RATING
}

enum EntityType {
  PERSON
  COMPANY
  OPPORTUNITY
}

// ─── Tags ───
model Tag {
  id          String          @id @default(cuid())
  name        String
  color       String          @default("#6366f1")

  workspaceId String
  workspace   Workspace       @relation(fields: [workspaceId], references: [id])
  assignments TagAssignment[]

  @@unique([workspaceId, name])
}

model TagAssignment {
  id            String       @id @default(cuid())
  tagId         String
  tag           Tag          @relation(fields: [tagId], references: [id])
  workspaceId   String
  workspace     Workspace    @relation(fields: [workspaceId], references: [id])
  personId      String?
  person        Person?      @relation(fields: [personId], references: [id])
  companyId     String?
  company       Company?     @relation(fields: [companyId], references: [id])
  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id])

  @@unique([tagId, personId])
  @@unique([tagId, companyId])
  @@unique([tagId, opportunityId])
}

// ─── Workflows ───
model Workflow {
  id          String        @id @default(cuid())
  name        String
  description String?
  isActive    Boolean       @default(false)
  trigger     Json
  steps       Json
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workspaceId String
  workspace   Workspace     @relation(fields: [workspaceId], references: [id])
  runs        WorkflowRun[]
}

model WorkflowRun {
  id          String            @id @default(cuid())
  status      WorkflowRunStatus @default(RUNNING)
  triggerData Json?
  stepResults Json?
  startedAt   DateTime          @default(now())
  finishedAt  DateTime?

  workflowId  String
  workflow    Workflow          @relation(fields: [workflowId], references: [id])
}

enum WorkflowRunStatus {
  RUNNING
  SUCCESS
  FAILED
}

// ─── Auth-related models managed by Better Auth ───
model Session {
  id                   String    @id
  expiresAt            DateTime
  token                String    @unique
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                   String    @id
  accountId            String
  providerId           String
  userId               String
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken          String?
  refreshToken         String?
  idToken              String?
  accessTokenExpiresAt DateTime?
  refreshTokenExpiresAt DateTime?
  scope                String?
  password             String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

model JoinRequest {
  id          String            @id @default(cuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String
  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  status      JoinRequestStatus @default(PENDING)
  createdAt   DateTime          @default(now())

  @@unique([userId, workspaceId])
}

enum JoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model Dashboard {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model Invitation {
  id          String     @id @default(cuid())
  email       String
  role        MemberRole @default(MEMBER)
  token       String     @unique
  expiresAt   DateTime
  workspaceId String
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now())
}

model View {
  id          String     @id @default(cuid())
  name        String
  entityType  EntityType
  type        ViewType   @default(TABLE)
  filters     Json?
  sorts       Json?
  isDefault   Boolean    @default(false)
  position    Int        @default(0)
  createdAt   DateTime   @default(now())

  workspaceId String
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdById String?
  createdBy   User?      @relation(fields: [createdById], references: [id])

  @@index([workspaceId, entityType])
}

enum ViewType {
  TABLE
  KANBAN
}
